#!/usr/bin/python3



# -------- IMPORTATIONS --------

#system
import os, sys






# -------- DECLARATIONS --------

#current executable directory
CXD = os.path.realpath(os.path.dirname(sys.argv[0]))
pCXD     = os.path.dirname(CXD)

#compilers
C_TO_ASM="gcc"

#paths
SRC_DIR        = pCXD + "/src"
SRC_ZROOTTYPES = SRC_DIR + "/zRootTypes.c"
DST_DIR        = pCXD + "/out/src"
DST_FILE_ASM   = DST_DIR + "/operators.asm"
DST_FILE_FP    = DST_DIR + "/operators.asm.cfg"






# -------- STD --------

#io
def readFile(filename):
	f = open(filename, "r")
	res = f.read()
	f.close()
	return res

def writeFile(filename, content):
	f = open(filename, "w")
	f.write(content)
	f.close()






# -------- OVER STD --------

#small version just for our need
def unpfxTypeName(n):
	if n == "void":
		return n
	if n.startswith("GU"):
		return n[2:]
	elif n.startswith("GD"):
		tmp = n.split("_GU")
		return tmp[0][2:] + '[' + tmp[1] + ']'
	raise ValueError("Type \"" + n + "\" not taken in charge in bld for now.")

#errors
def err(msg, code=1):
	print("genOperators: " + msg)
	exit(code)






# -------- FS --------

#get each file in a dir recursively
def fse__getTree(dir, ignoreHidden=True):
	res = []
	for fseName in os.listdir(dir):

		#hidden file
		if ignoreHidden:
			if fseName[0] == '.':
				continue

		#full path
		fseFullPath = dir + '/' + fseName

		#dir => add its content recursively
		if os.path.isdir(fseFullPath):
			res += fse__getTree(fseFullPath)

		#else, simply add it
		else:
			res.append(fseFullPath)
	return res

def catFullTree(srcDir):
	resC  = ""
	resFP = ""
	for filePath in fse__getTree(srcDir):
		cCode = readFile(filePath)

		#1st line has all information for fp
		tmp    = cCode.split('\n')[0].strip().split(' ')
		retTyp = unpfxTypeName(tmp[0])
		tmp    = ' '.join(tmp[1:]).split('(')
		name   = tmp[0]
		params = tmp[1].split(')')[0].split(', ')
		for p in range(len(params)):
			params[p] = unpfxTypeName(params[p].split(' ')[0])
		fpLine = "rf" + name + "\t\t" + retTyp + ',' + ','.join(params) + '\n'

		#add res
		resC  += cCode
		resFP += fpLine
	return (resC, resFP)






# -------- INITIALIZATION --------

#get arch type
arch_subdir = "arch32"
if len(sys.argv) < 2:
	err("Missing arch type 32 or 64 as 1st argument.")
if sys.argv[1] == "64":
	arch_subdir = "arch64"
elif sys.argv[1] != "32":
	err("Invalid value \"" + sys.argv[1] + "\" given as arch type (expected \"32\" or \"64\").", 2)






# -------- EXECUTION --------

#create dst dir
if not os.path.isdir(os.path.abspath(DST_DIR)):
	os.makedirs(DST_DIR)

#copy generic content
gncC, gncFP = catFullTree(SRC_DIR + "/gnc")

#add specific content (32/64)
spcC, spcFP = catFullTree(SRC_DIR + '/' + arch_subdir)

#compile C
writeFile("tmp.c", readFile(SRC_ZROOTTYPES) + gncC + spcC)
if os.system(C_TO_ASM + " -S tmp.c"):
	err("Errors when compiling gathered C sources.")

#asm res under correct name
if os.system("mv tmp.s " + DST_FILE_ASM):
	err("Unable to move generated ASM code tmp.s => " + DST_FILE_ASM)

#fp
writeFile(DST_FILE_FP, gncFP + spcFP)
